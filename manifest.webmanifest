{
  "name": "GymTracker",
  "short_name": "GymTracker",
  "description": "A private, offline gym log: exercises, sets, reps, weights, progress charts and one-tap sharing with your trainer.",
  "start_url": "./index.html#/log",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f9f9f7",
  "theme_color": "#f9f9f7",
  "categories": ["health", "fitness", "lifestyle"],
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Start a workout", "short_name": "Log", "url": "./index.html#/log" },
    { "name": "Progress charts", "short_name": "Progress", "url": "./index.html#/progress" }
  ]
}
